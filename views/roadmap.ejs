<!DOCTYPE html>
<html>
<head>
  <title>Your Roadmap - Voice2Skill</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
  <h1>Your Learning Roadmap</h1>
<% if (message === 'already_checked_in') { %>
  <p style="color: orange;">You've already checked in today — come back tomorrow!</p>
<% } %>
<% if (streak > 0) { %>
  <div class="message-banner" style="background: #1C2A10; color: #8FD14F;">
    🔥 <%= streak %>-day streak — don't break it!
  </div>
<% } %>
 <% roadmap.content.weeks.forEach(week => { %>
  <h2 data-week="<%= week.week_number %>"><%= week.focus %></h2>
  <ul>
    <% week.days.forEach(day => { %>
      <li>
        <strong>Day <%= day.day_number %>:</strong> <%= day.task %><br>
        <a href="<%= day.resource_url %>" target="_blank"><%= day.resource_name %></a>
        &nbsp;|&nbsp;
        <a href="https://www.youtube.com/results?search_query=<%= encodeURIComponent(day.video_search_term) %>" target="_blank">Prefer video? Search YouTube</a>
      </li>
    <% }) %>
  </ul>
<% }) %>

  <h2>Your Check-in History</h2>
  <% if (checkins.length === 0) { %>
    <p>No check-ins yet. Start today!</p>
  <% } else { %>
    <ul>
      <% checkins.forEach(checkin => { %>
        <li><%= checkin.checkin_date %> — <%= checkin.notes %></li>
      <% }) %>
    </ul>
  <% } %>

  <h2>Daily Check-in</h2>
  <form action="/roadmaps/<%= roadmap.id %>/checkin" method="POST">
    <textarea name="notes" placeholder="What did you work on today?" required></textarea>
    <button type="submit">Submit Check-in</button>
  </form>
</div>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <title>Your Roadmap - Voice2Skill</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Your personal 8-week Voice2Skill learning roadmap with daily tasks and AI coach check-ins.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'roadmap', roadmapUrl: '/roadmaps/' + roadmap.id }) %>

  <main class="app-wrap app-main" id="main">

    <% if (message === 'already_checked_in') { %>
      <div class="msg-banner">✓ You've already checked in today — come back tomorrow!</div>
    <% } else if (message === 'empty_notes') { %>
      <div class="msg-banner">Tell your coach what you worked on before submitting. ✍️</div>
    <% } %>

    <% if (streak > 0) { %>
      <div class="streak-banner">
        <span class="flame">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5z"/></svg>
        </span>
        <span>
          <b><%= streak %>-day streak — don't break it!</b>
          <span>Show up for today's check-in to keep it alive.</span>
        </span>
      </div>
    <% } %>

    <div class="app-head">
      <span class="app-eyebrow"><%= trackName ? trackName : 'Your roadmap' %></span>
      <h1>Your learning <span class="grad-text">roadmap</span></h1>
      <p>Day <%= currentDayNumber %> of <%= totalDays %><% if (todayTask) { %> — Week <%= todayTask.week_number %><% } %>. One step at a time.</p>
    </div>

    <% if (roadmap.goal) { %>
      <div class="goal-chip">
        <span class="goal-chip-label">Your goal</span>
        <span class="goal-chip-text">“<%= roadmap.goal %>”</span>
      </div>
    <% } %>

    <!-- Progress -->
    <div class="app-card progress-card">
      <div class="progress-top">
        <span>Overall progress</span>
        <b><%= Math.round((checkins.length / totalDays) * 100) %>%</b>
      </div>
      <div class="progress-bar">
        <i style="width: <%= Math.round((checkins.length / totalDays) * 100) %>%"></i>
      </div>
      <div class="progress-meta">
        <span><%= checkins.length %> check-ins completed</span>
        <span><%= totalDays - checkins.length %> days to go</span>
      </div>
    </div>

    <% if (isComplete) { %>
      <div class="app-card done-box">
        <span class="trophy" aria-hidden="true">🏆</span>
        <h2>You've completed your roadmap!</h2>
        <p>Incredible work. Check back soon for what's next.</p>
      </div>
    <% } else if (todayTask) { %>
      <!-- Today's task -->
      <div class="app-card">
        <div class="app-card-head">
          <h2>Today's task</h2>
          <span class="task-day">Day <%= todayTask.day_number %> · Week <%= todayTask.week_number %></span>
        </div>
        <% if (todayTask.day_type === 'weekend') { %>
          <span class="weekend-note">🌤️ Light day — review &amp; practice</span>
        <% } %>
        <h3 class="task-focus"><%= todayTask.week_focus %></h3>
        <p class="task-text"><%= todayTask.task %></p>
        <div class="task-links">
          <a class="btn btn-gold" href="<%= todayTask.resource_url %>" target="_blank" rel="noopener">
            Open resource: <%= todayTask.resource_name %>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m4-3h6v6m-11 5L21 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-ghost" href="https://www.youtube.com/results?search_query=<%= encodeURIComponent((typeof videoSearchPhrase !== 'undefined' && videoSearchPhrase) ? videoSearchPhrase : todayTask.video_search_term) %>" target="_blank" rel="noopener">
            Prefer video? Search YouTube
          </a>
        </div>
      </div>

      <!-- Daily check-in -->
      <div class="app-card">
        <div class="app-card-head">
          <h2>Daily check-in</h2>
        </div>
        <p style="margin-bottom: 0.9rem;">Tell your coach how today went — type it or speak it.</p>
        <form class="checkin-form" action="/roadmaps/<%= roadmap.id %>/checkin" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="visually-hidden" for="checkinNotes">What did you work on today?</label>
          <textarea name="notes" id="checkinNotes" placeholder="What did you work on today?" required></textarea>
          <div class="form-actions">
            <button type="button" class="btn btn-ghost" id="voiceBtn">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              Speak instead
            </button>
            <button type="submit" class="btn btn-gold">Submit check-in</button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- Check-in history -->
    <div class="app-card">
      <div class="app-card-head">
        <h2>Your check-in history</h2>
        <% if (checkins.length > 0) { %>
          <span class="task-day"><%= checkins.length %> total</span>
        <% } %>
      </div>
      <% if (checkins.length === 0) { %>
        <p class="empty-note">No check-ins yet. Start today!</p>
      <% } else { %>
        <ul class="history-list">
          <% checkins.forEach(checkin => { %>
            <li>
              <span class="h-date"><%= checkin.checkin_date %></span>
              <span class="h-notes"><%= checkin.notes %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

  </main>

  <script>
  const voiceBtn = document.getElementById('voiceBtn');
  const notesField = document.getElementById('checkinNotes');

  if (voiceBtn) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const micSvg = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
    const resetLabel = function () {
      voiceBtn.classList.remove('listening');
      voiceBtn.innerHTML = micSvg + ' Speak instead';
      voiceBtn.disabled = false;
    };

    if (!SpeechRecognition) {
      voiceBtn.style.display = 'none';
    } else {
      const recognition = new SpeechRecognition();
      recognition.lang = 'en-US';
      recognition.interimResults = false;
      recognition.continuous = false;
      recognition.maxAlternatives = 1;

      let isListening = false;
      let baseValue = '';

      voiceBtn.addEventListener('click', () => {
        if (isListening) return;
        isListening = true;
        voiceBtn.disabled = true;
        voiceBtn.classList.add('listening');
        voiceBtn.innerHTML = micSvg + ' Listening…';
        baseValue = notesField.value;

        try {
          recognition.start();
        } catch (err) {
          isListening = false;
          resetLabel();
        }
      });

      recognition.addEventListener('result', (event) => {
        const transcript = event.results[0][0].transcript;
        notesField.value = baseValue
          ? baseValue + ' ' + transcript
          : transcript;
      });

      recognition.addEventListener('end', () => {
        isListening = false;
        resetLabel();
      });

      recognition.addEventListener('error', (event) => {
        isListening = false;
        resetLabel();
        console.error('Speech recognition error:', event.error);
      });
    }
  }
</script>
</body>
</html>

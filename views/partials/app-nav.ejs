<header class="app-nav" id="appnav">
  <div class="app-wrap app-nav-inner">
    <a class="app-brand" href="/dashboard" aria-label="Voice2Skill dashboard">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect width="24" height="24" rx="7" fill="url(#appgrad)"/>
        <path d="M12 6.2a2.3 2.3 0 0 0-2.3 2.3v4a2.3 2.3 0 0 0 4.6 0v-4A2.3 2.3 0 0 0 12 6.2z" fill="#16130A"/>
        <path d="M7.4 12.4a4.6 4.6 0 0 0 9.2 0h1.2a5.8 5.8 0 0 1-5.2 5.77V20.6h3v1.4H7.4v-1.4h3v-2.43a5.8 5.8 0 0 1-5.2-5.77z" fill="#16130A"/>
        <defs>
          <linearGradient id="appgrad" x1="0" y1="0" x2="24" y2="24">
            <stop stop-color="#F0D27A"/><stop offset="1" stop-color="#C89B2E"/>
          </linearGradient>
        </defs>
      </svg>
      Voice2Skill
    </a>
    <nav aria-label="App">
      <ul class="app-nav-links">
        <li><a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
        <li><a href="/tracks" class="<%= active === 'tracks' ? 'active' : '' %>">Skill Tracks</a></li>
        <% if (typeof roadmapUrl !== 'undefined' && roadmapUrl) { %>
          <li><a href="<%= roadmapUrl %>" class="<%= active === 'roadmap' ? 'active' : '' %>">My Roadmap</a></li>
        <% } %>
      </ul>
    </nav>
    <div class="app-nav-cta">
      <a class="btn btn-ghost" href="/logout">Log out</a>
    </div>
  </div>
</header>
<script>
  (function () {
    var nav = document.getElementById('appnav');
    var onScroll = function () { nav.classList.toggle('scrolled', window.scrollY > 12); };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

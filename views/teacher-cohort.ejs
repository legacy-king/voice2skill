<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= cohort.name %> - Teacher - Voice2Skill</title>
  <%- include('partials/head-app') %>
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'teacher' }) %>

  <main class="app-wrap app-main" id="main">
    <section class="co-hero co-hero-left">
      <a class="co-back" href="/teacher">← All cohorts</a>
      <span class="app-eyebrow"><%= cohort.org_name %></span>
      <h1><span class="grad-text"><%= cohort.name %></span></h1>
      <% if (created) { %><div class="co-note" role="status">Cohort created. Share the code below with your students.</div><% } %>
      <% if (saved) { %><div class="co-note" role="status">Saved.</div><% } %>
      <% if (error) { %><div class="goal-error" role="alert"><%= error %></div><% } %>
      <div class="co-invite">
        <div><div class="co-muted">Invite code</div><span class="co-code co-code-lg"><%= cohort.invite_code %></span></div>
        <div><div class="co-muted">Seats</div><strong><%= cohort.seats_taken %><%= cohort.max_seats ? ' of ' + cohort.max_seats : '' %></strong><% if (cohort.max_seats && cohort.seats_taken >= cohort.max_seats) { %> <span class="co-pill co-pill-warn">Full</span><% } %></div>
        <% if (cohort.code_expires_at) { %><div><div class="co-muted">Code <%= codeExpired ? 'expired' : 'expires' %></div><strong><%= codeExpiresValue %></strong><% if (codeExpired) { %> <span class="co-pill co-pill-warn">Expired</span><% } %></div><% } %>
        <div class="co-invite-link"><div class="co-muted">Or share this link</div><input type="text" readonly value="<%= inviteUrl %>" data-select-on-click aria-label="Invite link"></div>
      </div>
    </section>

    <section class="co-section">
      <h2>Students (<%= students.length %>)</h2>
      <% if (students.length === 0) { %><p class="co-muted">Nobody has joined yet. Send them the code.</p><% } else { %>
      <div class="co-table-wrap">
        <table class="co-table">
          <thead><tr><th>Student</th><th>Status</th><th>Check-ins</th><th>Streak</th><th>Progress</th><th>Last check-in</th></tr></thead>
          <tbody>
            <% students.forEach(function (s) { %>
              <tr class="<%= s.atRisk ? 'co-row-stuck' : '' %>">
                <td><strong><%= s.name %></strong><div class="co-muted"><%= s.email %></div></td>
                <td>
                  <% if (s.paid) { %><span class="co-pill co-pill-ok">Active</span>
                  <% } else if (s.status === 'active') { %><span class="co-pill co-pill-warn">Expired</span>
                  <% } else { %><span class="co-pill">Not paid</span><% } %>
                </td>
                <td><%= s.checkin_count %></td>
                <td><%= s.streak %> day<%= s.streak === 1 ? '' : 's' %></td>
                <td><div class="co-bar" aria-label="<%= s.progressPct %>% of the 8-week roadmap"><span style="width: <%= s.progressPct %>%"></span></div></td>
                <td>
                  <% if (s.daysSince === null) { %><span class="co-muted">never</span>
                  <% } else if (s.daysSince === 0) { %>today
                  <% } else { %><%= s.daysSince %> day<%= s.daysSince === 1 ? '' : 's' %> ago<% } %>
                  <% if (s.atRisk) { %><span class="co-pill co-pill-warn">needs a nudge</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="co-fine">"Needs a nudge" = paid student with no check-in for <%= stuckAfterDays %>+ days. You can't see students' private check-in notes.</p>
      <% } %>
    </section>

    <section class="co-section">
      <h2>Earnings (all your cohorts)</h2>
      <div class="co-stats">
        <div class="co-stat"><div class="num"><%= naira(ledger.gross) %></div><div class="lbl">collected</div></div>
        <div class="co-stat"><div class="num"><%= naira(ledger.orgShare) %></div><div class="lbl">your share (<%= Number(cohort.revenue_share_pct) %>% of <%= cohort.share_basis %>)</div></div>
        <div class="co-stat"><div class="num"><%= naira(ledger.paidOut) %></div><div class="lbl">paid to you</div></div>
        <div class="co-stat"><div class="num grad-text"><%= naira(ledger.owed) %></div><div class="lbl">owed to you</div></div>
      </div>
    </section>

    <section class="co-section">
      <h2>Settings &amp; syllabus</h2>
      <form class="co-form" action="/teacher/cohorts/<%= cohort.id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Cohort name<input type="text" name="name" maxlength="150" value="<%= cohort.name %>" required></label>
        <div class="co-row">
          <label>Price per period (₦)<input type="number" name="price" min="0" max="1000000" step="1" value="<%= cohort.price_kobo / 100 %>" required></label>
          <label>Access days per payment<input type="number" name="accessDays" min="1" max="365" value="<%= cohort.access_days %>" required></label>
          <label>Seats (blank = no limit)<input type="number" name="maxSeats" min="1" max="10000" step="1" value="<%= cohort.max_seats || '' %>"></label>
          <label>Code expires on (blank = never)<input type="date" name="codeExpires" value="<%= codeExpiresValue %>"></label>
        </div>
        <label>AI mentor name <span class="co-muted">(students chat with “[this name]’s AI mentor”; leave blank to use your account name)</span>
          <input type="text" name="mentorName" maxlength="80" value="<%= cohort.mentor_name || '' %>" placeholder="e.g. Mr. Tunde">
        </label>
        <label>Syllabus <span class="co-muted">(the AI mentor answers from this; first ~6,000 characters are used)</span>
          <textarea name="curriculum" rows="14" maxlength="20000"><%= cohort.curriculum %></textarea>
        </label>
        <label class="co-check"><input type="checkbox" name="active" <%= cohort.active ? 'checked' : '' %>> Cohort is open (untick to stop NEW students joining; students who already paid keep their access)</label>
        <button type="submit" class="btn btn-gold">Save changes</button>
        <p class="co-fine">Price changes apply to future payments only.</p>
      </form>
    </section>
  </main>
  <script src="/js/teacher.js" defer></script>
  <%- include('partials/app-footer') %>
</body>
</html>

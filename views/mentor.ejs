<!DOCTYPE html>
<html lang="en">
<head>
  <title>AI Mentor - Voice2Skill</title>
  <%- include('partials/head-app') %>
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'mentor' }) %>

  <main class="app-wrap app-main co-chat-main" id="main">
    <header class="co-chat-head">
      <div>
        <% if (kind === 'premium') { %>
          <span class="app-eyebrow">Voice2Skill Premium</span>
          <h1>Your <span class="grad-text">AI Mentor</span></h1>
        <% } else { %>
          <span class="app-eyebrow"><%= orgName %> · <%= cohortName %></span>
          <h1><%= mentorName %>’s <span class="grad-text">AI Mentor</span></h1>
        <% } %>
      </div>
      <p class="co-muted" id="remaining" aria-live="polite"><%= remainingToday %> of <%= dailyLimit %> messages left today</p>
    </header>

    <% if (justPaid) { %><div class="co-note" role="status">Payment received. Your mentor access is active<%= accessUntil ? ' until ' + new Date(accessUntil).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %>.</div><% } %>

    <div class="co-chat" id="chat" role="log" aria-live="polite" aria-label="Conversation with your AI mentor">
      <% if (history.length === 0) { %>
        <% if (kind === 'premium') { %>
          <div class="co-msg co-msg-bot" id="welcome">Hi! I'm your Voice2Skill AI mentor. Ask me about today's lesson, paste an error you're stuck on, or tell me what you're working on.</div>
        <% } else { %>
          <div class="co-msg co-msg-bot" id="welcome">Hi! I'm <%= mentorName %>'s AI mentor for <%= cohortName %>. Ask me about anything from class, paste an error you're stuck on, or tell me what you're working on today. (I'm an AI — for grades or admin, ask <%= mentorName %> directly.)</div>
        <% } %>
      <% } %>
      <% history.forEach(function (h) { %>
        <div class="co-msg <%= h.role === 'user' ? 'co-msg-me' : 'co-msg-bot' %>"><%= h.content %></div>
      <% }) %>
    </div>

    <form class="co-composer" id="composer" autocomplete="off">
      <label class="visually-hidden" for="msg">Your message</label>
      <textarea id="msg" rows="2" maxlength="1000" placeholder="Ask your mentor…" required></textarea>
      <button type="submit" class="btn btn-gold" id="send">Send</button>
    </form>
    <p class="co-fine">AI can make mistakes — check important answers with your tutor. Don't paste passwords or private information.</p>
  </main>

  <script>
    (function () {
      var csrf = <%- JSON.stringify(csrfToken) %>;
      var chat = document.getElementById('chat');
      var form = document.getElementById('composer');
      var box = document.getElementById('msg');
      var send = document.getElementById('send');
      var remaining = document.getElementById('remaining');
      var dailyLimit = <%= dailyLimit %>;
      var pendingText = null, pendingId = null; // keep the same id when retrying a failed send

      function newId() {
        var a = new Uint8Array(16); crypto.getRandomValues(a);
        return Array.prototype.map.call(a, function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
      }
      function bubble(text, cls) {
        var d = document.createElement('div');
        d.className = 'co-msg ' + cls;
        d.textContent = text; // textContent: model/user text is never parsed as HTML
        chat.appendChild(d);
        chat.scrollTop = chat.scrollHeight;
        return d;
      }
      var ERR = {
        no_access: 'Your mentor access has ended. Renew it on the Join page.',
        daily_limit: 'You\'ve used today\'s messages. Come back tomorrow — consistency beats cramming.',
        monthly_limit: 'You\'ve reached this month\'s message limit. Ask your tutor if you need more.',
        ai_unavailable: 'The mentor is unavailable right now. Your message was not counted — press Send to retry.',
        in_progress: 'Still working on your last message…'
      };
      chat.scrollTop = chat.scrollHeight;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var text = box.value.trim();
        if (!text) return;
        if (text !== pendingText) { pendingText = text; pendingId = newId(); }
        send.disabled = true;
        var welcome = document.getElementById('welcome'); if (welcome) welcome.remove();
        var mine = bubble(text, 'co-msg-me');
        var wait = bubble('Thinking…', 'co-msg-bot co-msg-wait');
        box.value = '';

        fetch('/mentor/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({ message: text, clientMsgId: pendingId })
        }).then(function (r) {
          return r.json().catch(function () { return { error: 'ai_unavailable' }; }).then(function (j) { return { ok: r.ok, status: r.status, body: j }; });
        }).then(function (res) {
          wait.remove();
          if (res.ok && res.body.reply) {
            bubble(res.body.reply, 'co-msg-bot');
            pendingText = pendingId = null;
            if (typeof res.body.remainingToday === 'number') remaining.textContent = res.body.remainingToday + ' of ' + dailyLimit + ' messages left today';
          } else {
            mine.remove(); box.value = text; // let them retry the same text (same id => never double-billed)
            bubble(ERR[res.body.error] || 'Something went wrong. Please try again.', 'co-msg-bot co-msg-err');
            if (res.body.error === 'daily_limit' || res.body.error === 'monthly_limit' || res.body.error === 'no_access') pendingText = pendingId = null;
          }
        }).catch(function () {
          wait.remove(); mine.remove(); box.value = text;
          bubble('Network problem. Check your connection and press Send to retry.', 'co-msg-bot co-msg-err');
        }).then(function () { send.disabled = false; box.focus(); });
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
      });
    })();
  </script>
</body>
</html>

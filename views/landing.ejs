<!DOCTYPE html>
<html lang="en">
<head>
  <title>Voice2Skill — Speak it. Learn it. Earn it.</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Say or type the digital skill you want to learn and get a free 8-week plan through the best free resources. Go Premium for an AI coach and mentor, or learn through your bootcamp with your tutor's AI mentor.">
  <meta name="theme-color" content="#0B0B0E">
  <link rel="canonical" href="<%= appUrl %>/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Voice2Skill">
  <meta property="og:title" content="Voice2Skill — Speak it. Learn it. Earn it.">
  <meta property="og:description" content="A free 8-week learning plan, an AI coach and mentor on Premium, and AI mentors for bootcamps and organizations.">
  <meta property="og:url" content="<%= appUrl %>/">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Voice2Skill — Speak it. Learn it. Earn it.">
  <meta name="twitter:description" content="A free 8-week learning plan, an AI coach and mentor on Premium, and AI mentors for bootcamps and organizations.">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/landing.css">
  <noscript><style>.landing .reveal { opacity: 1; transform: none; }</style></noscript>
</head>
<body class="landing">
<% const premium = (typeof premiumPrice !== 'undefined' && premiumPrice) || '₦6,000'; %>

  <a class="skip-link" href="#main">Skip to content</a>

  <!-- ===== Nav ===== -->
  <header class="nav" id="topnav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="Voice2Skill home">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect width="24" height="24" rx="7" fill="url(#g1)"/>
          <path d="M12 6.2a2.3 2.3 0 0 0-2.3 2.3v4a2.3 2.3 0 0 0 4.6 0v-4A2.3 2.3 0 0 0 12 6.2z" fill="#16130A"/>
          <path d="M7.4 12.4a4.6 4.6 0 0 0 9.2 0h1.2a5.8 5.8 0 0 1-5.2 5.77V20.6h3v1.4H7.4v-1.4h3v-2.43a5.8 5.8 0 0 1-5.2-5.77z" fill="#16130A"/>
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="24" y2="24">
              <stop stop-color="#F0D27A"/><stop offset="1" stop-color="#C89B2E"/>
            </linearGradient>
          </defs>
        </svg>
        Voice2Skill
      </a>
      <nav aria-label="Primary">
        <ul class="nav-links">
          <li><a href="#how">How it works</a></li>
          <li><a href="#skills">Skill tracks</a></li>
          <li><a href="#bootcamps">For bootcamps</a></li>
          <li><a href="#plans">Plans</a></li>
        </ul>
      </nav>
      <div class="nav-cta">
        <a class="nav-login" href="/login">Log in</a>
        <a class="btn btn-gold" href="/signup">Get started free</a>
      </div>
    </div>
  </header>

  <main id="main">

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill"><span class="pulse-dot" aria-hidden="true"></span> Your personal AI skill coach</span>
        <h1>
          Speak it.
          <span class="grad-text">Learn it. Earn it.</span>
        </h1>
        <p class="hero-sub">
          Say or type the digital skill you want to learn — software engineering, design,
          data, marketing, or security — and get a <strong>free 8-week plan</strong> that walks
          you through the best free resources, day by day. Want to learn with AI? Go
          <strong>Premium</strong>, or learn through your bootcamp with your tutor’s AI mentor.
        </p>
        <div class="hero-cta">
          <a class="btn btn-gold" href="/signup">
            Start free
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-ghost" href="#plans">See plans</a>
        </div>
        <ul class="hero-trust">
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Free plan to start
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Premium <%= premium %>/month
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Bootcamp &amp; organization plans
          </li>
        </ul>
      </div>

      <div class="hero-mock" aria-hidden="true" role="presentation">
        <div class="mock-glow"></div>
        <div class="mock-card">
          <div class="mock-top">
            <div class="mock-user">
              <span class="mock-avatar">M</span>
              <span>
                <strong>Your AI coach · Premium</strong>
                <span>replied to your check-in · just now</span>
              </span>
            </div>
            <span class="mock-streak">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5z"/></svg>
              12-day streak
            </span>
          </div>
          <div class="mock-body">
            <div class="mock-label">
              <span>Day 25 check-in</span>
              <span>CSS Grid</span>
            </div>
            <p class="mock-note">Finished the grid lesson and the quiz. Still a bit confused about auto-fit vs auto-fill.</p>
            <div class="coach-bubble">
              <span class="typing" id="coach-type">Nice work — 25 days in and you’re still showing up. 🎉</span>
            </div>
            <div class="mock-input">
              <span class="ph">Type or speak how today went…</span>
              <span class="mock-mic">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
            </div>
          </div>
        </div>
        <div class="mock-chip">
          <div class="chip-top">
            <span>Week 4 of 8 · Software</span>
            <b>46%</b>
          </div>
          <div class="bar"><i></i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Stats ===== -->
  <div class="stats">
    <div class="wrap stats-inner">
      <div class="stat reveal">
        <div class="num"><span class="grad-text">56</span>&nbsp;lessons</div>
        <div class="lbl">one a day for 8 weeks</div>
      </div>
      <div class="stat reveal" style="--d:.08s">
        <div class="num"><span class="grad-text">8</span>&nbsp;projects</div>
        <div class="lbl">one to build each week</div>
      </div>
      <div class="stat reveal" style="--d:.16s">
        <div class="num"><span class="grad-text">5</span>&nbsp;tracks</div>
        <div class="lbl">to choose from</div>
      </div>
      <div class="stat reveal" style="--d:.24s">
        <div class="num"><span class="grad-text">1</span>&nbsp;check-in</div>
        <div class="lbl">a day to keep your streak</div>
      </div>
    </div>
  </div>

  <!-- ===== How it works ===== -->
  <section class="sec-pad" id="how">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Three steps. <span class="grad-text">Zero course fees.</span></h2>
        <p>No 40-hour video courses. Just a plan, a lesson a day, and a reason to show up tomorrow.</p>
      </div>
      <div class="steps">
        <article class="step reveal">
          <span class="step-num">01 — GOAL</span>
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>Tell us your goal</h3>
          <p>Say it or type it. “I want to become a frontend developer” is enough to match you to the right skill track.</p>
        </article>
        <article class="step reveal" style="--d:.1s">
          <span class="step-num">02 — PLAN</span>
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="5" r="1.4" fill="currentColor"/><circle cx="13" cy="12" r="1.4" fill="currentColor"/><circle cx="9" cy="19" r="1.4" fill="currentColor"/></svg>
          </div>
          <h3>Get your 8-week plan</h3>
          <p>Every day has a short lesson, a quiz question and a hand-off to a free resource; every week ends with a project. Software Engineering starts with an 8-question level check so the plan fits where you are.</p>
        </article>
        <article class="step reveal" style="--d:.2s">
          <span class="step-num">03 — MOMENTUM</span>
          <div class="step-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h3>Check in daily</h3>
          <p>Type or speak a quick note on how it went to keep your streak, with a reminder email on days you forget. On Premium, your AI coach replies with what you did well, one insight, and your next step.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== Skills ===== -->
  <section class="sec-pad skills" id="skills">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Skill tracks</span>
        <h2>Pick the skill. <span class="grad-text">We’ll map the path.</span></h2>
        <p>Five in-demand digital skills, each with its own 8-week roadmap and coach.</p>
      </div>
      <div class="skills-grid">
        <article class="skill-card reveal">
          <span class="glyph">&lt;/&gt;</span>
          <h3>Software Engineering</h3>
          <p>HTML, CSS, JavaScript, React, Node.js — build and ship real software.</p>
        </article>
        <article class="skill-card reveal" style="--d:.06s">
          <span class="glyph">✦</span>
          <h3>UI/UX Design</h3>
          <p>Design thinking, Figma, and interfaces people love.</p>
        </article>
        <article class="skill-card reveal" style="--d:.12s">
          <span class="glyph">∑</span>
          <h3>Data Analysis</h3>
          <p>Spreadsheets, SQL, and insights that drive decisions.</p>
        </article>
        <article class="skill-card reveal" style="--d:.18s">
          <span class="glyph">◎</span>
          <h3>Digital Marketing</h3>
          <p>Content, SEO, and campaigns that reach people.</p>
        </article>
        <article class="skill-card reveal" style="--d:.24s">
          <span class="glyph">⚿</span>
          <h3>Cybersecurity</h3>
          <p>Fundamentals of protecting systems and data.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== What you get ===== -->
  <section class="sec-pad" id="why">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">What you get</span>
        <h2>Free to start. <span class="grad-text">AI when you want it.</span></h2>
        <p>Everyone gets the plan and the daily habit. Premium and bootcamp learners also get an AI coach and mentor.</p>
      </div>
      <div class="feat-grid">
        <article class="feat reveal">
          <span class="feat-tag">Free</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2v3m0 12V5m0 0H4m2.5 0h5a5 5 0 0 1 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>A path through free resources</h3>
          <p>An 8-week plan that tells you exactly what to learn each day and where to learn it — free docs, tutorials and videos.</p>
        </article>
        <article class="feat reveal" style="--d:.07s">
          <span class="feat-tag">Free</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>Speak or type</h3>
          <p>Say your goal and your daily check-ins out loud, or type them. Whatever is quicker for you.</p>
        </article>
        <article class="feat reveal" style="--d:.14s">
          <span class="feat-tag">Free</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h3>Streaks, projects and reminders</h3>
          <p>A project every week, a streak you can see, and a reminder email on days you haven’t checked in.</p>
        </article>
        <article class="feat reveal" style="--d:.21s">
          <span class="feat-tag feat-tag-paid">Premium</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>An AI coach on every check-in</h3>
          <p>Feedback that knows your track and level: what you did well, one insight, and your next step.</p>
        </article>
        <article class="feat reveal" style="--d:.28s">
          <span class="feat-tag feat-tag-paid">Premium</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h3>An AI mentor to ask anything</h3>
          <p>Stuck on today’s lesson or an error message? Ask your AI mentor any time — it knows where you are in your plan.</p>
        </article>
        <article class="feat reveal" style="--d:.35s">
          <span class="feat-tag">Free</span>
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l1.9 5.6L20 10l-6.1 1.4L12 17l-1.9-5.6L4 10l6.1-1.4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h3>Starts at your level</h3>
          <p>For Software Engineering, an 8-question check places you at foundation, builder or professional before your plan is made.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== For bootcamps ===== -->
  <section class="sec-pad skills" id="bootcamps">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">For bootcamps &amp; tutors</span>
        <h2>Your teaching, <span class="grad-text">available 24/7.</span></h2>
        <p>Your students keep learning between classes with an AI mentor that carries your name and answers from your syllabus — while you see who is keeping up.</p>
      </div>
      <div class="feat-grid">
        <article class="feat reveal">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <h3>Your AI mentor, in your name</h3>
          <p>Students chat with “[your name]’s AI mentor”, grounded in the syllabus you paste — so it teaches what you teach.</p>
        </article>
        <article class="feat reveal" style="--d:.07s">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V9m6 10V5m6 14v-7m4 7H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>Monitor every student</h3>
          <p>A roster with each student’s check-ins and last activity, flagging anyone who has gone quiet so you can nudge them. Private notes stay private.</p>
        </article>
        <article class="feat reveal" style="--d:.14s">
          <div class="feat-icon">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
          <h3>Earn from every student</h3>
          <p>Set your price and share one invite code. Students pay in naira through Paystack, and you see your share of earnings as it builds.</p>
        </article>
      </div>
      <p class="cta-note reveal">Already have a code from your tutor? <a href="/join">Join your cohort</a></p>
    </div>
  </section>

  <!-- ===== Plans ===== -->
  <section class="sec-pad" id="plans">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Plans</span>
        <h2>Pick how you <span class="grad-text">want to learn.</span></h2>
        <p>Start free. Pay only when you want to learn with AI.</p>
      </div>
      <div class="plans">
        <article class="plan reveal">
          <h3>Free</h3>
          <p class="plan-price"><span class="grad-text">₦0</span></p>
          <p class="plan-for">Self-learners who want a clear path</p>
          <ul>
            <li>8-week plan through the best free resources</li>
            <li>Daily lessons, quizzes and weekly projects</li>
            <li>Check-ins, streaks and reminder emails</li>
            <li>Level check for Software Engineering</li>
          </ul>
          <a class="btn btn-ghost" href="/signup">Start free</a>
        </article>
        <article class="plan plan-featured reveal" style="--d:.07s">
          <span class="plan-badge">Most popular</span>
          <h3>Premium</h3>
          <p class="plan-price"><span class="grad-text"><%= premium %></span> <span class="plan-per">/ month</span></p>
          <p class="plan-for">Individuals who want to learn with AI</p>
          <ul>
            <li>Everything in Free</li>
            <li>AI coach feedback on every check-in</li>
            <li>AI mentor chat about your lessons and errors</li>
            <li>Paid securely in naira through Paystack</li>
          </ul>
          <a class="btn btn-gold" href="/join">Get Premium</a>
        </article>
        <article class="plan reveal" style="--d:.14s">
          <h3>Bootcamp</h3>
          <p class="plan-price"><span class="grad-text">Set by your tutor</span></p>
          <p class="plan-for">Students learning through a bootcamp or tutor</p>
          <ul>
            <li>Everything in Premium</li>
            <li>Your tutor’s AI mentor, trained on their syllabus</li>
            <li>Your tutor sees your progress and nudges you</li>
          </ul>
          <a class="btn btn-ghost" href="/join">Join with a code</a>
        </article>
        <article class="plan reveal" id="organizations" style="--d:.21s">
          <h3>Organizations</h3>
          <p class="plan-price"><span class="grad-text">Talk to us</span></p>
          <p class="plan-for">Bootcamps, schools and teams</p>
          <ul>
            <li>Run your own cohorts with invite codes</li>
            <li>Your AI mentor in your name, on your syllabus</li>
            <li>Roster, progress tracking and earnings</li>
            <li>Revenue share on every paying student</li>
          </ul>
          <a class="btn btn-ghost" href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@voice2skill.com' %>?subject=Voice2Skill%20for%20organizations">Contact us</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <div class="cta-band">
    <div class="wrap">
      <div class="cta-inner reveal">
        <span class="eyebrow">Start free · Upgrade any time</span>
        <h2>Your first check-in takes <span class="grad-text">a minute.</span></h2>
        <p>Tell us what you want to learn. Your plan and today’s lesson are waiting — and Premium is there when you want an AI mentor.</p>
        <a class="btn btn-gold" href="/signup">Start free</a>
        <p class="cta-note">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>

  </main>

  <!-- ===== Footer ===== -->
  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect width="24" height="24" rx="7" fill="url(#g2)"/>
              <path d="M12 6.2a2.3 2.3 0 0 0-2.3 2.3v4a2.3 2.3 0 0 0 4.6 0v-4A2.3 2.3 0 0 0 12 6.2z" fill="#16130A"/>
              <path d="M7.4 12.4a4.6 4.6 0 0 0 9.2 0h1.2a5.8 5.8 0 0 1-5.2 5.77V20.6h3v1.4H7.4v-1.4h3v-2.43a5.8 5.8 0 0 1-5.2-5.77z" fill="#16130A"/>
              <defs>
                <linearGradient id="g2" x1="0" y1="0" x2="24" y2="24">
                  <stop stop-color="#F0D27A"/><stop offset="1" stop-color="#C89B2E"/>
                </linearGradient>
              </defs>
            </svg>
            Voice2Skill
          </a>
          <p>From learning to earning. A free 8-week plan for the digital skills that pay — with an AI coach and mentor on Premium and for bootcamp cohorts.</p>
        </div>
        <div class="footer-links">
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="#how">How it works</a></li>
              <li><a href="#skills">Skill tracks</a></li>

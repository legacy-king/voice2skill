<!DOCTYPE html>
<html lang="en">
<head>
  <title>Dashboard - Voice2Skill</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'dashboard' }) %>

  <main class="app-wrap app-main">
    <section class="dash-hero">
      <span class="app-eyebrow">Your AI skill coach</span>
      <h1>Welcome, <span class="grad-text"><%= user.name %></span> 👋</h1>
      <p>Tell us what you want to learn and we'll map the closest skill track for you — free 8-week roadmap, daily coach check-ins included.</p>

      <% if (goalError === 'no_match') { %>
        <div class="goal-error" role="alert">We couldn't match "<%= goalValue %>" to a track. Try rewording it, or pick one below.</div>
      <% } else if (goalError === 'empty') { %>
        <div class="goal-error" role="alert">Tell us what you want to learn first — e.g. "I want to build websites".</div>
      <% } %>

      <form class="goal-form" action="/dashboard/goal" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="goal-input-wrap">
          <input type="text" name="goal" id="goalInput" placeholder="I want to learn…" value="<%= goalValue %>" required autocomplete="off">
          <button type="button" class="goal-mic" id="goalMic" aria-label="Speak your goal">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </div>
        <button type="submit" class="btn btn-gold">Map my goal</button>
      </form>
      <p class="goal-hint">Try "build websites", "make an app", "analyze data", "run ads", or "hacking".</p>

      <div class="dash-actions">
        <a class="btn btn-ghost" href="/tracks">Browse all tracks</a>
      </div>
      <span class="dash-email"><%= user.email %></span>
    </section>

    <div class="dash-stats">
      <div class="dash-stat">
        <div class="num">8 <span class="grad-text">weeks</span></div>
        <div class="lbl">to a new digital skill</div>
      </div>
      <div class="dash-stat">
        <div class="num">5 <span class="grad-text">tracks</span></div>
        <div class="lbl">to choose from</div>
      </div>
      <div class="dash-stat">
        <div class="num">1 <span class="grad-text">check-in</span></div>
        <div class="lbl">a day with your coach</div>
      </div>
    </div>

    <% if (tracks && tracks.length > 0) { %>
    <% const glyphs = ['</>', '✦', '∑', '◎', '⚿']; %>
    <div class="quick-picks">
      <span class="quick-picks-label">Or jump straight to a track:</span>
      <div class="quick-picks-row">
        <% tracks.forEach((track, i) => { %>
          <form method="POST" action="/tracks/<%= track.id %>/select" class="quick-pick-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="quick-pick">
              <span class="quick-pick-glyph"><%= glyphs[i % glyphs.length] %></span>
              <%= track.name %>
            </button>
          </form>
        <% }) %>
      </div>
    </div>
    <% } %>
  </main>

  <script>
    const goalInput = document.getElementById('goalInput');
    const goalMic = document.getElementById('goalMic');

    if (goalMic) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

      if (!SpeechRecognition) {
        goalMic.style.display = 'none';
      } else {
        const recognition = new SpeechRecognition();
        recognition.lang = 'en-US';
        recognition.interimResults = false;

        let isListening = false;

        goalMic.addEventListener('click', () => {
          if (isListening) return;
          isListening = true;
          goalMic.classList.add('listening');
          goalMic.setAttribute('aria-label', 'Listening…');
          recognition.start();
        });

        recognition.addEventListener('result', (event) => {
          const transcript = event.results[0][0].transcript;
          goalInput.value = goalInput.value.trim()
            ? goalInput.value.trim() + ' ' + transcript
            : transcript;
        });

        recognition.addEventListener('end', () => {
          isListening = false;
          goalMic.classList.remove('listening');
          goalMic.setAttribute('aria-label', 'Speak your goal');
        });

        recognition.addEventListener('error', (event) => {
          isListening = false;
          goalMic.classList.remove('listening');
          goalMic.setAttribute('aria-label', 'Speak your goal');
          console.error('Speech recognition error:', event.error);
        });
      }
    }
  </script>
</body>
</html>

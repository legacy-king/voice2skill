<!DOCTYPE html>
<html lang="en">
<head>
  <title>Verify your email - Voice2Skill</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
  <main class="auth-wrap">
    <div class="auth-card">
      <a class="auth-brand" href="/" aria-label="Voice2Skill home">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect width="24" height="24" rx="7" fill="url(#authgrad)"/>
          <path d="M12 6.2a2.3 2.3 0 0 0-2.3 2.3v4a2.3 2.3 0 0 0 4.6 0v-4A2.3 2.3 0 0 0 12 6.2z" fill="#16130A"/>
          <path d="M7.4 12.4a4.6 4.6 0 0 0 9.2 0h1.2a5.8 5.8 0 0 1-5.2 5.77V20.6h3v1.4H7.4v-1.4h3v-2.43a5.8 5.8 0 0 1-5.2-5.77z" fill="#16130A"/>
          <defs>
            <linearGradient id="authgrad" x1="0" y1="0" x2="24" y2="24">
              <stop stop-color="#F0D27A"/><stop offset="1" stop-color="#C89B2E"/>
            </linearGradient>
          </defs>
        </svg>
        Voice2Skill
      </a>

      <h1>Verify your email</h1>

      <% if (typeof sent !== 'undefined' && sent) { %>
        <p class="auth-sub">📬 We sent a confirmation link to your inbox. Click it to activate your account — it expires in 24 hours.</p>
      <% } else if (typeof error !== 'undefined' && error === 'invalid') { %>
        <div class="auth-error" role="alert">This verification link is invalid or has expired.</div>
        <p class="auth-sub">Enter your email below to get a fresh link.</p>
      <% } else if (typeof error !== 'undefined' && error === 'send_failed') { %>
        <div class="auth-error" role="alert">We couldn't send the email right now. Enter your email below to try again.</div>
      <% } else if (typeof error !== 'undefined' && error === 'invalid_email') { %>
        <div class="auth-error" role="alert">Please enter a valid email address.</div>
        <p class="auth-sub">We'll send you a fresh verification link.</p>
      <% } else { %>
        <p class="auth-sub">Enter your email and we'll send you a verification link.</p>
      <% } %>

      <form class="auth-form" action="/verify-email/resend" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="email" name="email" placeholder="Email" required autocomplete="email">
        <button type="submit" class="btn btn-gold">Resend verification email</button>
      </form>

      <p class="auth-foot">Already verified? <a href="/login">Log in</a></p>
      <a class="auth-home" href="/">← Back to home</a>
    </div>
  </main>
</body>
</html>

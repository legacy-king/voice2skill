<!DOCTYPE html>
<html lang="en">
<head>
  <title>Security - Voice2Skill</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Manage the devices signed in to your Voice2Skill account and revoke sessions you don't recognize.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'security' }) %>

  <main class="app-wrap app-main" id="main">
    <div class="app-head">
      <span class="app-eyebrow">Account security</span>
      <h1>Security settings</h1>
      <p>Manage the devices signed in to <strong><%= user.email %></strong> — revoke any you don't recognize.</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="msg-banner" role="status">✓ Session revoked. That device has been signed out.</div>
    <% } else if (typeof error !== 'undefined' && error === 'self') { %>
      <div class="auth-error" role="alert">You can't revoke the device you're currently using.</div>
    <% } else if (typeof error !== 'undefined' && error === 'missing') { %>
      <div class="auth-error" role="alert">No session selected.</div>
    <% } %>

    <div class="app-card">
      <div class="app-card-head">
        <h2>Active sessions</h2>
        <span class="sessions-count"><%= sessions.length %> device<%= sessions.length === 1 ? '' : 's' %></span>
      </div>

      <% if (sessions.length === 0) { %>
        <p class="empty-note">No active sessions found.</p>
      <% } else { %>
        <ul class="session-list">
          <% sessions.forEach((s) => { %>
            <li class="session-item <%= s.isCurrent ? 'is-current' : '' %>">
              <div class="session-device">
                <span class="session-glyph" aria-hidden="true"><%= s.isCurrent ? '◉' : '○' %></span>
                <div>
                  <div class="session-name">
                    <%= s.device %>
                    <% if (s.isCurrent) { %><span class="badge-current">This device</span><% } %>
                  </div>
                  <div class="session-meta">
                    IP <%= s.ip %>
                    <% if (s.isCurrent) { %>
                      · <span class="active-now">Active now</span>
                    <% } else if (s.lastActiveAt) { %>
                      · Last active <%= s.lastActiveAt.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                    <% } %>
                    <% if (s.signedInAt) { %> · Signed in <%= s.signedInAt.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %><% } %>
                    <% if (s.expiresAt) { %> · Expires <%= s.expiresAt.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %><% } %>
                  </div>
                </div>
              </div>
              <% if (!s.isCurrent) { %>
                <form method="POST" action="/security/revoke" class="revoke-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="sid" value="<%= s.sid %>">
                  <button type="submit" class="btn btn-ghost btn-danger-ghost">Revoke</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="app-card">
      <div class="app-card-head">
        <h2>Password</h2>
      </div>
      <p>Change your password — every other device will be signed out.</p>
      <div class="dash-actions" style="margin-top: 1rem;">
        <a class="btn btn-ghost" href="/change-password">Change password</a>
      </div>
    </div>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Choose a Track - Voice2Skill</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pick a Voice2Skill track — Web Development, UI/UX Design, Data Analysis, Digital Marketing, or Cybersecurity — and get a free 8-week roadmap.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23D4AF37'/%3E%3Cpath d='M12 6a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0v-4A2.5 2.5 0 0 0 12 6z' fill='%2316130A'/%3E%3Cpath d='M7.2 12.5a4.8 4.8 0 0 0 9.6 0h1.4a6.2 6.2 0 0 1-5.6 6.15V21h3.4v1.4H7.4V21h3.4v-2.35a6.2 6.2 0 0 1-5.6-6.15z' fill='%2316130A'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
  <%- include('partials/app-nav', { active: 'tracks' }) %>

  <main class="app-wrap app-main" id="main">
    <div class="app-head">
      <span class="app-eyebrow">Skill tracks</span>
      <h1>Choose your <span class="grad-text">track</span></h1>
      <p>Pick the skill you want to master. Each track comes with a free 8-week roadmap and an AI coach that checks in daily.</p>
    </div>

    <div class="track-grid">
      <% const glyphs = ['</>', '✦', '∑', '◎', '⚿']; %>
      <% tracks.forEach((track, i) => { %>
        <form method="POST" action="/tracks/<%= track.id %>/select">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="track-card">
            <span class="glyph"><%= glyphs[i % glyphs.length] %></span>
            <h3><%= track.name %></h3>
            <p><%= track.description %></p>
            <span class="track-go">Start this track</span>
          </button>
        </form>
      <% }) %>
    </div>
  </main>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
  <title>Choose a Track - Voice2Skill</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
  <h1>Choose Your Track</h1>
  <ul>
    <% tracks.forEach(track => { %>
      <li>
        <a href="/tracks/<%= track.id %>/select">
          <h3><%= track.name %></h3>
          <p><%= track.description %></p>
        </a>
      </li>
    <% }) %>
  </ul>
  </div>
</body>
</html>
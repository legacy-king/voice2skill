# --- core ---
DATABASE_URL=postgres://user:pass@host/db
SESSION_SECRET=change-me-long-random-string
NODE_ENV=production
PORT=3000
# Public URL of the site (used in emails, payment callback, invite links)
APP_URL=https://voice2skill.com
# Shown on privacy/terms and the landing page Organizations "Contact us"
SUPPORT_EMAIL=support@voice2skill.com

# --- AI ---
GEMINI_API_KEY=
# Optional: cheaper model for the mentor chat (check the exact id in Google AI Studio). Default: gemini-3.6-flash
MENTOR_MODEL=
MENTOR_DAILY_LIMIT=40
# Premium (individual) daily mentor messages; the monthly cap above is shared.
PREMIUM_DAILY_LIMIT=10
MENTOR_MONTHLY_LIMIT=300

# --- email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- payments (Paystack) ---
# Use sk_test_... first. Webhook URL to set in the Paystack dashboard: https://voice2skill.com/webhooks/paystack
PAYSTACK_SECRET_KEY=

# --- tuning ---
# Max signup/login attempts per IP per 15 min. A whole class on one wifi shares an IP.
AUTH_RATE_MAX=60
# Local dev only:
# DATABASE_SSL=false
# PAYSTACK_MOCK=1
# MENTOR_MOCK=1
# EMAIL_MODE=log

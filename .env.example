# --- core ---
DATABASE_URL=postgres://user:pass@host/db
SESSION_SECRET=change-me-long-random-string
NODE_ENV=production
PORT=3000
# Public URL of the site (used in emails, payment callback, invite links)
APP_URL=https://voice2skill.com
# Shown on privacy/terms and the landing page Organizations "Contact us"
SUPPORT_EMAIL=support@voice2skill.com

# --- AI (LLM router: services/llm.js, config in config/llm.js) ---
# Only providers allowed for student text get check-ins and mentor chats (see config/llm.js):
# Groq with Zero Data Retention ON (console > Data Controls), Gemini on the PAID tier.
GROQ_KEY=
# Paid-tier Gemini key. GEMINI_API_KEY is still accepted.
GEMINI_KEY=
# Optional. Mistral is used for student text only after you switch training off in its console AND
# set MISTRAL_NO_TRAINING=1 (then name Mistral in views/privacy.ejs).
MISTRAL_KEY=
# MISTRAL_NO_TRAINING=1
# Optional, Course Library generation only (no personal data). Needs a model: LLM_MODEL_OPENROUTER=<id>:free
OPENROUTER_KEY=
# Optional overrides: route order per task (mentor, checkin, roadmap, course), models, timeouts.
# LLM_ROUTE_MENTOR=groq,gemini,mistral
# LLM_ROUTE_STT=groq,gemini
# LLM_MODEL_GROQ=openai/gpt-oss-120b
# LLM_MODEL_GEMINI=gemini-3.6-flash
# LLM_MODEL_GEMINI_MENTOR=        (MENTOR_MODEL still works for this)
# LLM_MODEL_GROQ_STT=whisper-large-v3   (default whisper-large-v3-turbo)
# LLM_TIMEOUT_MS=20000            per attempt for mentor/checkin
# LLM_TIMEOUT_COURSE_MS=120000
# LLM_MAX_TOKENS_COURSE=16000
# Voice input (POST /api/voice/transcribe -> router task "stt", Groq whisper-large-v3-turbo first).
# Daily clips per user; Free users get voice too (PLAN D2). Max upload bytes (~60 s of audio).
STT_DAILY_LIMIT_FREE=20
STT_DAILY_LIMIT_PAID=60
STT_MAX_BYTES=3145728
MENTOR_DAILY_LIMIT=40
# Premium (individual) daily mentor messages; the monthly cap above is shared.
PREMIUM_DAILY_LIMIT=10
MENTOR_MONTHLY_LIMIT=300
# Course Library generation (scripts/courses.js; background jobs) goes through the router (task
# "course"). Extra retries per week on top of provider failover:
COURSE_RETRIES=3
# Published course versions kept in memory
COURSE_CACHE_SIZE=50
# Background job runner (inside the web process). JOBS_DISABLED=1 keeps a process out of the queue.
JOB_POLL_MS=15000
JOB_STALE_MINUTES=15
# JOBS_DISABLED=1

# --- email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- payments (Paystack) ---
# Use sk_test_... first. Webhook URL to set in the Paystack dashboard: https://voice2skill.com/webhooks/paystack
PAYSTACK_SECRET_KEY=

# --- tuning ---
# Max signup/login attempts per IP per 15 min. A whole class on one wifi shares an IP.
AUTH_RATE_MAX=60
# Local dev only:
# DATABASE_SSL=false
# PAYSTACK_MOCK=1
# MENTOR_MOCK=1
# COURSE_MOCK=1
# EMAIL_MODE=log
